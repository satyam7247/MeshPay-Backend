# Brevo transactional email (keep the real .env out of version control)
BREVO_API_KEY=your_real_api_key
BREVO_SENDER_EMAIL=your_verified_email
BREVO_SENDER_NAME=Offline UPI Mesh
# Twilio remains enabled for OTP flows that use SMS. Bank-link OTP can independently use email in development.
SMS_PROVIDER=twilio
BANK_LINK_OTP_PROVIDER=twilio
ACCOUNT_DELETION_OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_a_real_secret_in_local_env
TWILIO_VERIFY_SERVICE_SID=
ALLOW_EMAIL_BANK_LINK_OTP=false
ALLOW_EMAIL_ACCOUNT_DELETION_OTP=false
APP_ENVIRONMENT=development
UPI_MESH_DEMO_ENDPOINTS_ENABLED=false
BANK_LINK_OTP_PROVIDER=email
BANK_LINK_OTP_HMAC_SECRET=replace_with_a_real_secret_in_local_env

# Cashfree Secure ID bank verification
BANK_VERIFICATION_PROVIDER=cashfree
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
BANK_DATA_ENCRYPTION_KEY=base64_encoded_32_byte_aes_key
